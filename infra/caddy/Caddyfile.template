# Render with scripts/bootstrap_origin.sh. Keep this file free of secrets.
{
	admin off
	persist_config off
	auto_https off
}

http://127.0.0.1:__ORIGIN_PORT__ {
	bind 127.0.0.1
	root * __RELEASE_ROOT__/current
	encode gzip

	# Health is an explicit artifact. It must never fall through to index.html.
	@health path /healthz
	handle @health {
		rewrite * /healthz.json
		header Cache-Control "no-store, max-age=0"
		file_server
	}

	# Asset requests are file-only: a missing JS/PDF/scan/audio file is a real 404.
	@static_asset path_regexp static_asset \.(js|css|json|webp|png|jpe?g|svg|pdf|m4a|vtt|woff2?|ttf|otf)$
	@hashed_asset path_regexp hashed_asset ^/assets/[^/]+-[A-Za-z0-9_-]{8,64}\.(js|css|json|webp|png|jpe?g|svg|pdf|m4a|vtt|woff2?|ttf|otf)$
	handle @static_asset {
		header @hashed_asset Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Shell and route metadata are revalidated after each release promotion.
	@metadata path / /index.html /catalog.json /release.json /healthz.json
	handle @metadata {
		header Cache-Control "no-cache, max-age=0, must-revalidate"
		file_server
	}

	# Only application routes receive SPA fallback. The asset handler above is
	# mutually exclusive, so a missing asset cannot become index.html.
	handle {
		try_files {path} /index.html
		header Cache-Control "no-cache, max-age=0, must-revalidate"
		file_server
	}
}
