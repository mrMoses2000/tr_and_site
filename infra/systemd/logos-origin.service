[Unit]
Description=Logos immutable web origin (Caddy)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=logos
Group=logos
ExecStart=/usr/bin/caddy run --config /etc/logos/Caddyfile --adapter caddyfile
Restart=on-failure
RestartSec=5s
TimeoutStopSec=10s
Environment=XDG_DATA_HOME=/var/lib/caddy
Environment=XDG_CONFIG_HOME=/etc/caddy

# Caddy only serves verified releases and does not need the ingestion surface.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadOnlyPaths=/srv/logos/releases /srv/logos/current
InaccessiblePaths=/srv/logos/staging /srv/logos/backups /home/moses/tr_and_site/storage
ReadWritePaths=/var/lib/caddy /var/log/caddy
UMask=0027

[Install]
WantedBy=multi-user.target
